{
  "name": "djbrain",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "description": "A local React Router app for music discovery and import workflows",
  "author": "example.com",
  "homepage": "/",
  "private": true,
  "scripts": {
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "analyze:local": "pnpm --filter @djbrain/workers analyze:local",
    "admin": "pnpm --filter @djbrain/workers admin",
    "downloader": "pnpm --filter @djbrain/workers downloader",
    "sync": "pnpm --filter @djbrain/workers sync",
    "start": "pnpm --filter @djbrain/server start",
    "dev:server": "pnpm --filter @djbrain/server dev",
    "dev:client": "pnpm --filter @djbrain/web dev",
    "dev": "concurrently -k -n api,web \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build": "pnpm run typecheck && pnpm --filter @djbrain/web build",
    "preview": "pnpm --filter @djbrain/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.2.6"
  },
  "engines": {
    "node": "24.11.1",
    "pnpm": "11.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
